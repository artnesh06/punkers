{
  "name": "punkers-survival-nextjs",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:property": "jest --testPathPattern=tests/property",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:watch": "jest --watch",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "migrate:certificate": "npx prisma migrate dev --name add_certificate_table",
    "test:certificate": "ts-node scripts/test-certificate-migration.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@rainbow-me/rainbowkit": "^2.1.0",
    "@tanstack/react-query": "^5.56.0",
    "@vercel/analytics": "^2.0.1",
    "ioredis": "^5.3.2",
    "jose": "^6.2.2",
    "next": "^15.5.29",
    "pino-pretty": "^11.0.0",
    "react": "^19",
    "react-dom": "^19",
    "swiper": "^12.1.2",
    "viem": "^2.47.6",
    "wagmi": "^2.12.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.5.0",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^20.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.29",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "fast-check": "^3.22.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.3.0",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "overrides": {
    "postcss": "^8.5.32"
  }
