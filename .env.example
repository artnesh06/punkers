# Database
DATABASE_URL="postgresql://user:password@localhost:5432/punkers_survival?schema=public"

# Base URL for metadata (production URL)
NEXT_PUBLIC_BASE_URL="https://punkers.wtf"

# Ethereum Network Configuration
NEXT_PUBLIC_CHAIN_ID=1

# NFT Contract Address (read-only for ownership verification)
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS="0x9b2c7964da7b986b08862ba5903ed994e57efcc7"

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="YOUR_PROJECT_ID"

# Optional: Alchemy/Infura API Key for RPC
NEXT_PUBLIC_ALCHEMY_API_KEY=""

# Admin API Key (for admin endpoints)
# Generate a secure random string for production
# Example: openssl rand -hex 32
ADMIN_API_KEY=""

# Admin Web Panel Credentials (for /punkers/admin)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeme"

# Marketplace API Keys (optional - for floor price and volume data)
# Get from: https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=""

# Get from: https://docs.reservoir.tools/reference/getting-started
# Note: Reservoir works without API key but has lower rate limits
RESERVOIR_API_KEY=""

# Redis Configuration (for caching and rate limiting)
# Works on any platform (Vercel, local, other hosting)
REDIS_URL="redis://default:password@localhost:6379"

# Session Secret (for certificate session tokens)
# Generate a secure random string for production
# Example: openssl rand -hex 32
SESSION_SECRET=""

# Discord OAuth2 (get from https://discord.com/developers/applications)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Twitter/X OAuth2 (get from https://developer.twitter.com/en/portal)
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
